# Copy this file to .env.local and fill in the values from your Supabase
# project → Settings → API. See README.md → "Collegare Supabase" for the
# full setup guide.

# The base "Project URL" (e.g. https://xxxxxxxx.supabase.co) — NOT the
# /rest/v1 or /auth/v1 endpoint.
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" "public" key from the same page.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
